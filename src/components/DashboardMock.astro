---
---

<div class="mock-wrapper" data-reveal>
  <!-- Browser chrome -->
  <div class="browser-chrome">
    <div class="browser-dots" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="browser-url" aria-hidden="true">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.45;flex-shrink:0">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      app.orbitstay.com.br/dashboard
    </div>
  </div>

  <!-- Dashboard area -->
  <div class="dashboard-area">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 32 32">
          <defs>
            <linearGradient id="sb-logo-g" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#6C5CE7"/>
              <stop offset="100%" stop-color="#00CEC9"/>
            </linearGradient>
          </defs>
          <rect width="32" height="32" rx="7" fill="url(#sb-logo-g)"/>
          <text x="16" y="22" font-family="system-ui" font-size="17" font-weight="700" fill="white" text-anchor="middle">O</text>
        </svg>
        <span class="sb-brand"><span class="sb-orbit">ORBIT</span><span class="sb-stay">stay</span></span>
      </div>

      <nav class="sidebar-nav" aria-label="Navegação do dashboard">
        <span class="nav-item nav-item--active">
          <span class="ni" aria-hidden="true">⊞</span>
          <span class="nl">Dashboard</span>
        </span>
        <span class="nav-item">
          <span class="ni" aria-hidden="true">📅</span>
          <span class="nl">Reservas</span>
        </span>
        <span class="nav-item">
          <span class="ni" aria-hidden="true">🚪</span>
          <span class="nl">Quartos</span>
        </span>
        <span class="nav-item">
          <span class="ni" aria-hidden="true">👤</span>
          <span class="nl">Hóspedes</span>
        </span>
        <span class="nav-item">
          <span class="ni" aria-hidden="true">💰</span>
          <span class="nl">Financeiro</span>
        </span>
        <span class="nav-item">
          <span class="ni" aria-hidden="true">🌐</span>
          <span class="nl">Site</span>
        </span>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="dash-main">
      <!-- Header -->
      <div class="dash-header">
        <h2 class="dash-title">Dashboard</h2>
        <span class="badge-today">Hoje</span>
      </div>

      <!-- KPI cards -->
      <div class="kpi-row">
        <div class="kpi-card">
          <span class="kpi-label">Ocupação</span>
          <span class="kpi-value kpi-gradient">78%</span>
          <span class="kpi-delta up">↑ 4% vs ontem</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-label">Reservas</span>
          <span class="kpi-value kpi-cyan">142</span>
          <span class="kpi-delta up">↑ 12 este mês</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-label">Receita</span>
          <span class="kpi-value kpi-accent">R$&nbsp;48.200</span>
          <span class="kpi-delta up">↑ 8% vs mês ant.</span>
        </div>
      </div>

      <!-- Bar chart -->
      <div class="chart-section" aria-hidden="true">
        <span class="chart-label">Ocupação por dia</span>
        <div class="chart-bars">
          <div class="bar-col"><div class="bar" style="height:60%"></div><span class="bar-day">Seg</span></div>
          <div class="bar-col"><div class="bar" style="height:75%"></div><span class="bar-day">Ter</span></div>
          <div class="bar-col"><div class="bar" style="height:45%"></div><span class="bar-day">Qua</span></div>
          <div class="bar-col"><div class="bar bar--hi" style="height:90%"></div><span class="bar-day bar-day--hi">Qui</span></div>
          <div class="bar-col"><div class="bar" style="height:65%"></div><span class="bar-day">Sex</span></div>
          <div class="bar-col"><div class="bar" style="height:80%"></div><span class="bar-day">Sáb</span></div>
          <div class="bar-col"><div class="bar" style="height:55%"></div><span class="bar-day">Dom</span></div>
        </div>
      </div>
    </main>
  </div>
</div>

<style>
  .mock-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Browser chrome ───────────────────────── */
  .browser-chrome {
    background: #0d1117;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 12px 12px 0 0;
    border: 1px solid var(--border);
    border-bottom: none;
  }

  .browser-dots {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
  }
  .dot-red    { background: #ff5f57; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green  { background: #28c840; }

  .browser-url {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    font-size: 11px;
    font-family: 'Outfit', monospace, sans-serif;
    padding: 4px 12px;
    border-radius: 6px;
    margin: 0 auto;
    max-width: 280px;
    width: 100%;
    justify-content: center;
  }

  /* ── Dashboard layout ─────────────────────── */
  .dashboard-area {
    background: var(--navy);
    border: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    display: flex;
    height: 420px;
    overflow: hidden;
    box-shadow:
      0 40px 80px rgba(0,0,0,0.5),
      0 0 0 1px var(--border);
  }

  /* ── Sidebar ──────────────────────────────── */
  .sidebar {
    width: 180px;
    flex-shrink: 0;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow: hidden;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px 14px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }

  .sb-brand {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .sb-orbit { color: var(--white); }
  .sb-stay  { color: var(--cyan); }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    cursor: default;
    user-select: none;
  }

  .nav-item--active {
    background: rgba(108, 92, 231, 0.2);
    color: var(--accent-light);
  }

  .ni {
    font-size: 13px;
    width: 16px;
    text-align: center;
    flex-shrink: 0;
  }

  /* ── Main ─────────────────────────────────── */
  .dash-main {
    flex: 1;
    padding: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .dash-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dash-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }

  .badge-today {
    background: rgba(253, 203, 110, 0.15);
    color: var(--amber);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 100px;
    border: 1px solid rgba(253, 203, 110, 0.25);
  }

  /* ── KPI row ──────────────────────────────── */
  .kpi-row {
    display: flex;
    gap: 10px;
  }

  .kpi-card {
    flex: 1;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .kpi-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .kpi-value {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kpi-gradient {
    background: var(--gradient-full);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .kpi-cyan   { color: var(--cyan); }
  .kpi-accent { color: var(--accent-light); }

  .kpi-delta {
    font-size: 10px;
    color: var(--muted);
  }
  .kpi-delta.up { color: #00b894; }

  /* ── Chart ────────────────────────────────── */
  .chart-section {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chart-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chart-bars {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding-bottom: 4px;
    min-height: 0;
  }

  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 100%;
    justify-content: flex-end;
  }

  .bar {
    width: 100%;
    background: linear-gradient(180deg, rgba(108,92,231,0.7) 0%, rgba(108,92,231,0.25) 100%);
    border-radius: 4px 4px 0 0;
    min-height: 4px;
  }

  .bar--hi {
    background: linear-gradient(180deg, #6C5CE7 0%, #A29BFE 100%);
    box-shadow: 0 0 12px rgba(108,92,231,0.45);
  }

  .bar-day {
    font-size: 9px;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .bar-day--hi {
    color: var(--accent-light);
    font-weight: 600;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 640px) {
    .mock-wrapper { padding: 0 16px; }

    .dashboard-area { height: 340px; }

    .sidebar {
      width: 40px;
      padding: 12px 6px;
    }

    .sb-brand,
    .nl,
    .sidebar-logo svg {
      display: none;
    }

    .sidebar-logo {
      justify-content: center;
      padding: 4px 0 10px;
    }

    .kpi-value { font-size: 15px; }
    .browser-url { font-size: 10px; }
  }
</style>

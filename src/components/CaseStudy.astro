---
---

<section class="case-section">
  <div class="case-inner">
    <div class="section-badge" data-reveal>Caso de sucesso</div>

    <div class="case-header" data-reveal data-delay="1">
      <h2>Yes Hotel</h2>
      <span class="case-location">Corumbá — Mato Grosso do Sul</span>
    </div>

    <div class="case-grid">
      <!-- Coluna esquerda: texto e métricas -->
      <div class="case-content" data-reveal data-delay="2">
        <p class="case-text">
          O Yes Hotel adotou o ORBITstay e eliminou a necessidade de recepcionista para check-in.
          Hóspedes chegam, fazem check-in pelo celular, recebem a senha da fechadura e entram no quarto.
          Tudo sem papel, sem fila, sem espera.
        </p>

        <div class="case-metrics">
          <div class="metric">
            <div class="metric-value gradient-text">-40%</div>
            <div class="metric-label">tempo de check-in</div>
          </div>
          <div class="metric">
            <div class="metric-value gradient-text">100%</div>
            <div class="metric-label">digital</div>
          </div>
          <div class="metric">
            <div class="metric-value gradient-text">0</div>
            <div class="metric-label">recepção obrigatória</div>
          </div>
        </div>
      </div>

      <!-- Coluna direita: imagem placeholder -->
      <div class="case-image-col" data-reveal data-delay="3">
        <!-- TODO: substituir por foto autorizada do Yes Hotel -->
        <div class="image-placeholder">
          <span class="placeholder-emoji">🏨</span>
          <p class="placeholder-name">Yes Hotel — Corumbá, MS</p>
          <p class="placeholder-note">Substituir por foto real em produção</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .case-section {
    padding: 100px 24px;
    background: var(--ink);
  }

  .case-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(108, 92, 231, 0.3);
    background: rgba(108, 92, 231, 0.1);
    color: var(--accent-light);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .case-header {
    margin-bottom: 48px;
  }

  .case-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .case-location {
    font-size: 1rem;
    color: var(--muted);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .case-text {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .case-metrics {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-value {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 500;
  }

  .image-placeholder {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    padding: 32px;
  }

  .placeholder-emoji {
    font-size: 3rem;
    line-height: 1;
  }

  .placeholder-name {
    font-size: 0.95rem;
    color: var(--muted);
    font-weight: 500;
  }

  .placeholder-note {
    font-size: 0.75rem;
    color: rgba(136, 153, 180, 0.5);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .case-section {
      padding: 60px 16px;
    }

    .case-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    /* texto primeiro no mobile (já está primeiro no DOM) */

    .case-header h2 {
      font-size: 2rem;
    }

    .metric-value {
      font-size: 2.2rem;
    }
  }
</style>

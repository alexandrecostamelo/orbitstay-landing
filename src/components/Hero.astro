---

<section class="hero" id="hero">
  <!-- Background radial glow orbs -->
  <div class="orb orb-accent" aria-hidden="true"></div>
  <div class="orb orb-cyan" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Badge -->
    <div class="hero-badge" data-reveal>
      <span class="badge-star" aria-hidden="true">✦</span>
      PMS + Booking Engine + Site — tudo integrado
    </div>

    <!-- H1 -->
    <h1 class="hero-title" data-reveal data-delay="1">
      Seu hotel funcionando no<br />
      <span class="gradient-text">piloto automático</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-sub" data-reveal data-delay="2">
      Gestão completa, check-in digital, fechadura inteligente e reservas
      diretas. Zero recepção obrigatória — do cadastro ao check-out,
      100% digital.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas" data-reveal data-delay="3">
      <!-- TODO: substituir pelo número real do WhatsApp comercial -->
      <a
        href="https://wa.me/5567984020002?text=Ol%C3%A1%21%20Quero%20saber%20mais%20sobre%20o%20ORBITstay."
        class="cta-primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com vendas pelo WhatsApp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Falar com vendas →
      </a>

      <a href="#como-funciona" class="cta-secondary">
        Como funciona →
      </a>
      <a
        href="https://app.orbitstay.com.br/cadastro"
        class="cta-signup"
        aria-label="Criar conta grátis — 14 dias sem cartão"
      >
        Criar conta grátis →
      </a>
    </div>

    <!-- Trust badges -->
    <div class="trust-row" data-reveal data-delay="4" aria-label="Certificações e garantias">
      <span class="trust-item">
        <span aria-hidden="true">🔒</span> PCI-Compliant
      </span>
      <span class="trust-item">
        <span aria-hidden="true">🇧🇷</span> Servidores no Brasil
      </span>
      <span class="trust-item">
        <span aria-hidden="true">📋</span> LGPD
      </span>
      <span class="trust-item">
        <span aria-hidden="true">⚡</span> 99.9% Uptime
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-top: 80px;
  }

  /* Radial glow background */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 800px 600px at 20% 50%, var(--accent-glow) 0%, transparent 70%),
      radial-gradient(ellipse 600px 500px at 80% 30%, var(--cyan-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Decorative orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }

  .orb-accent {
    width: 600px;
    height: 600px;
    top: -100px;
    left: -150px;
    background: var(--accent-glow);
    opacity: 0.6;
  }

  .orb-cyan {
    width: 500px;
    height: 500px;
    bottom: -80px;
    right: -100px;
    background: var(--cyan-glow);
    opacity: 0.8;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-light);
    background: rgba(108, 92, 231, 0.1);
    border: 1px solid rgba(108, 92, 231, 0.3);
    border-radius: 100px;
    padding: 6px 16px;
    margin-bottom: 28px;
  }

  .badge-star {
    color: var(--accent);
    font-size: 10px;
  }

  /* H1 */
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    max-width: 800px;
  }

  /* Subtitle */
  .hero-sub {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 40px;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 48px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gradient-primary);
    color: #fff;
    font-weight: 600;
    border-radius: 10px;
    padding: 14px 28px;
    font-size: 15px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--accent-light);
    font-weight: 600;
    border-radius: 10px;
    padding: 14px 28px;
    font-size: 15px;
    border: 1px solid rgba(108, 92, 231, 0.4);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .cta-secondary:hover {
    border-color: var(--accent);
    color: var(--white);
    transform: translateY(-1px);
  }

  .cta-signup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--muted);
    font-weight: 500;
    border-radius: 10px;
    padding: 14px 20px;
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cta-signup:hover { color: var(--white); }

  /* Trust row */
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero-inner {
      padding: 60px 20px;
      align-items: center;
      text-align: center;
    }

    .hero-title {
      text-align: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .trust-row {
      justify-content: center;
      gap: 16px;
    }
  }
</style>

---
const steps = [
  {
    num: '01',
    icon: '👤',
    title: 'Crie sua conta',
    desc: 'E-mail, senha e nome do hotel. 30 segundos.',
  },
  {
    num: '02',
    icon: '⚙️',
    title: 'Configure o hotel',
    desc: 'Endereço, quartos, fotos e tarifas no wizard guiado.',
  },
  {
    num: '03',
    icon: '🌐',
    title: 'Publique seu site',
    desc: 'Escolha um template e publique em subdomínio grátis.',
  },
  {
    num: '04',
    icon: '🚀',
    title: 'Receba reservas',
    desc: 'Motor de reservas ativo. Zero recepção, 100% digital.',
  },
];
---

<section id="como-funciona" class="hiw-section">
  <div class="hiw-inner">
    <div class="section-header" data-reveal>
      <div class="section-badge">Como funciona</div>
      <h2>Do cadastro à primeira reserva</h2>
      <span class="muted-sub">em menos de 1 hora.</span>
    </div>

    <div class="steps-wrapper">
      {steps.map((step, i) => (
        <>
          <div class="step" data-reveal data-delay={String(i + 1)}>
            <div class="step-num-bg">{step.num}</div>
            <div class="step-icon-wrap">
              <span class="step-icon">{step.icon}</span>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="step-connector" aria-hidden="true"></div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .hiw-section {
    padding: 100px 24px;
    background: var(--navy);
  }

  .hiw-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(108, 92, 231, 0.3);
    background: rgba(108, 92, 231, 0.1);
    color: var(--accent-light);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .muted-sub {
    display: block;
    color: var(--muted);
    font-size: 1.2rem;
    font-weight: 400;
  }

  .steps-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .step {
    flex: 1;
    position: relative;
    text-align: center;
    padding: 0 16px;
  }

  .step-num-bg {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 6rem;
    font-weight: 800;
    color: rgba(108, 92, 231, 0.08);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .step-icon-wrap {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(108, 92, 231, 0.5);
    background: rgba(108, 92, 231, 0.1);
    border-radius: 12px;
    margin: 0 auto 16px;
  }

  .step-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .step-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }

  .step-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .step-connector {
    flex: 0 0 auto;
    width: 60px;
    height: 1px;
    background: var(--gradient-primary);
    margin-top: 24px;
    align-self: flex-start;
  }

  @media (max-width: 768px) {
    .hiw-section {
      padding: 60px 16px;
    }

    .steps-wrapper {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .step {
      width: 100%;
      max-width: 320px;
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
    }

    .step:last-child {
      border-bottom: none;
    }

    .step-connector {
      display: none;
    }

    .step-num-bg {
      font-size: 4rem;
    }

    .section-header h2 {
      font-size: 2rem;
    }
  }
</style>

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Col 1: Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="logo-orbit">ORBIT</span><span class="logo-stay">stay</span>
        </a>
        <p class="footer-tagline">
          Plataforma completa de gestão hoteleira. PMS, booking engine, check-in digital
          e fechadura inteligente.
        </p>
      </div>

      <!-- Col 2: Produto -->
      <div class="footer-col">
        <h4 class="footer-col-title">Produto</h4>
        <ul class="footer-links">
          <li><a href="#recursos">Recursos</a></li>
          <li><a href="#planos">Planos</a></li>
          <li><a href="#como-funciona">Como funciona</a></li>
          <li><a href="#casos">Casos</a></li>
        </ul>
      </div>

      <!-- Col 3: Empresa -->
      <div class="footer-col">
        <h4 class="footer-col-title">Empresa</h4>
        <ul class="footer-links">
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contato">Contato</a></li>
          <li><a href="/termos">Termos de uso</a></li>
          <li><a href="/privacidade">Privacidade</a></li>
          <li><a href="/seguranca">Segurança</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© 2026 ORBITstay. Todos os direitos reservados.</span>
      <span class="footer-brazil">Feito no Brasil 🇧🇷</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    border-top: 1px solid var(--border);
    padding: 64px 24px 32px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: inline-flex;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .logo-orbit {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-stay {
    color: var(--white);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 260px;
  }

  .footer-col-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 16px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .footer-links a {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 2rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-copy,
  .footer-brazil {
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-tagline {
      max-width: 100%;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

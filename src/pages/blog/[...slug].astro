---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .filter((p) => p.data.category === post.data.category || p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 3);

// Se nao tiver 3 relacionados, completa com mais recentes
if (related.length < 3) {
  const more = allPosts
    .filter((p) => p.slug !== post.slug && !related.find((r) => r.slug === p.slug))
    .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
    .slice(0, 3 - related.length);
  related.push(...more);
}

const CATEGORY_META: Record<string, { label: string; color: string }> = {
  gestao:       { label: 'Gestão',       color: '#3B82F6' },
  tecnologia:   { label: 'Tecnologia',   color: '#8B5CF6' },
  tendencias:   { label: 'Tendências',   color: '#14B8A6' },
  revenue:      { label: 'Revenue',      color: '#22C55E' },
  experiencia:  { label: 'Experiência',  color: '#EC4899' },
  operacao:     { label: 'Operação',     color: '#F97316' },
};

const cat = CATEGORY_META[post.data.category];
const url = `https://orbitstay.com.br/blog/${post.slug}/`;

function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}
function gradientFor(category: string) {
  const c = CATEGORY_META[category]?.color ?? '#6C5CE7';
  return `linear-gradient(135deg, ${c} 0%, #0B1120 100%)`;
}

// Schema.org Article + BreadcrumbList
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt,
    dateModified: post.data.updatedAt ?? post.data.publishedAt,
    author: { '@type': 'Person', name: post.data.author.name },
    publisher: {
      '@type': 'Organization',
      name: 'ORBITstay',
      logo: { '@type': 'ImageObject', url: 'https://orbitstay.com.br/og-image.png' },
    },
    image: post.data.image.src.startsWith('http') ? post.data.image.src : `https://orbitstay.com.br${post.data.image.src}`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    keywords: post.data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://orbitstay.com.br/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://orbitstay.com.br/blog/' },
      { '@type': 'ListItem', position: 3, name: cat?.label ?? post.data.category, item: `https://orbitstay.com.br/blog/?cat=${post.data.category}` },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: url },
    ],
  },
];

// Headings H2/H3 pra TOC
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout
  title={`${post.data.title} | Blog ORBITstay`}
  description={post.data.description}
  canonical={post.data.seo?.canonical ?? url}
  ogType="article"
  ogTitle={post.data.seo?.ogTitle ?? post.data.title}
  ogDescription={post.data.seo?.ogDescription ?? post.data.description}
  jsonLd={jsonLd}
  hideDefaultJsonLd={true}
>
  <Navbar />

  <main class="blog-article">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-hidden="true">›</li>
          <li><span class="crumb-cat" style={`color:${cat?.color ?? '#6C5CE7'}`}>{cat?.label ?? post.data.category}</span></li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <header class="article-hero" style={`background: ${gradientFor(post.data.category)}`}>
      <div class="container article-hero-content">
        <span class="article-cat" style={`background:${cat?.color ?? '#6C5CE7'}; color:#fff`}>{cat?.label ?? post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="article-sub">{post.data.description}</p>
        <div class="article-meta">
          <span>{post.data.author.name} · {post.data.author.role}</span>
          <span aria-hidden="true">·</span>
          <span>{fmtDate(post.data.publishedAt)}</span>
          <span aria-hidden="true">·</span>
          <span>{post.data.readTime} min de leitura</span>
        </div>
      </div>
    </header>

    <!-- Layout: TOC + conteudo -->
    <div class="article-body">
      <div class="container article-grid">
        <!-- Sidebar TOC -->
        <aside class="article-toc" aria-label="Indice do artigo">
          <p class="toc-title">Neste artigo</p>
          <ul>
            {tocItems.map((h) => (
              <li class={h.depth === 3 ? 'toc-sub' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Conteudo -->
        <article class="article-content">
          <Content />

          <!-- CTA inline meio do artigo é injetado dentro do .md via marker - aqui só CTA final -->
          <div class="cta-final">
            <h3>Pronto para automatizar seu hotel?</h3>
            <p>O ORBITstay traz tudo numa plataforma só: PMS, motor de reservas, check-in digital com FNRH, integração com TTLock, WhatsApp e channel manager.</p>
            <a href="/cadastro" class="cta-final-btn">Testar grátis 14 dias →</a>
          </div>

          <!-- Tags -->
          <div class="article-tags" aria-label="Tags do artigo">
            {post.data.tags.map((tag) => (
              <span class="article-tag">#{tag}</span>
            ))}
          </div>
        </article>
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="related">
        <div class="container">
          <h2 class="related-title">Continue lendo</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/blog/${r.slug}/`} class="related-card">
                <div class="related-cover" style={`background: ${gradientFor(r.data.category)}`}>
                  <span>{r.data.title.split(' ').slice(0, 2).join(' ')}</span>
                </div>
                <div class="related-info">
                  <span class="related-cat" style={`color:${CATEGORY_META[r.data.category]?.color ?? '#6C5CE7'}`}>
                    {CATEGORY_META[r.data.category]?.label ?? r.data.category}
                  </span>
                  <h3>{r.data.title}</h3>
                  <p>{r.data.readTime} min de leitura</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .blog-article {
    background: var(--bg, #0a0d18);
    color: var(--white, #fff);
    padding-top: 64px;
    min-height: 100vh;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumb */
  .breadcrumb {
    padding: 24px 0 8px;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: var(--muted, #94a3b8);
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: #fff;
  }
  .crumb-cat {
    font-weight: 600;
  }

  /* Hero */
  .article-hero {
    padding: 64px 0 80px;
    margin: 16px 0 0;
  }
  .article-hero-content {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .article-cat {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .article-hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.3);
  }
  .article-sub {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    margin: 0 0 24px;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,0.7);
  }

  /* Body grid */
  .article-body {
    padding: 56px 0 64px;
  }
  .article-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 64px;
    align-items: start;
  }

  /* TOC */
  .article-toc {
    position: sticky;
    top: 96px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .toc-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted, #94a3b8);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 14px;
  }
  .article-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-toc li {
    font-size: 14px;
    line-height: 1.4;
  }
  .article-toc li.toc-sub {
    padding-left: 14px;
    font-size: 13px;
  }
  .article-toc a {
    color: var(--muted, #94a3b8);
    text-decoration: none;
    transition: color 0.2s;
  }
  .article-toc a:hover {
    color: #fff;
  }

  /* Conteudo (prose customizado) */
  .article-content {
    max-width: 720px;
    color: rgba(255,255,255,0.92);
    font-size: 18px;
    line-height: 1.8;
  }
  .article-content :global(h2) {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 56px 0 20px;
    color: #fff;
    scroll-margin-top: 96px;
  }
  .article-content :global(h2:first-child) {
    margin-top: 0;
  }
  .article-content :global(h3) {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 36px 0 12px;
    color: #fff;
    scroll-margin-top: 96px;
  }
  .article-content :global(p) {
    margin: 0 0 24px;
  }
  .article-content :global(strong) {
    color: #fff;
    font-weight: 600;
  }
  .article-content :global(a) {
    color: var(--cyan, #00CEC9);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article-content :global(a:hover) {
    color: #fff;
  }
  .article-content :global(ul), .article-content :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.5rem;
  }
  .article-content :global(li) {
    margin-bottom: 8px;
  }
  .article-content :global(blockquote) {
    border-left: 4px solid var(--cyan, #00CEC9);
    background: rgba(0, 206, 201, 0.08);
    padding: 16px 24px;
    margin: 32px 0;
    border-radius: 0 8px 8px 0;
    font-style: italic;
  }
  .article-content :global(.inline-cta) {
    margin: 40px 0;
    padding: 28px;
    background: linear-gradient(135deg, rgba(108,92,231,0.18) 0%, rgba(0,206,201,0.18) 100%);
    border: 1px solid rgba(108,92,231,0.35);
    border-radius: 16px;
    text-align: center;
  }
  .article-content :global(.inline-cta h4) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: #fff;
  }
  .article-content :global(.inline-cta p) {
    margin: 0 0 16px;
    color: rgba(255,255,255,0.8);
    font-size: 15px;
  }
  .article-content :global(.inline-cta a) {
    display: inline-block;
    background: var(--gradient-primary, linear-gradient(135deg, #6C5CE7, #00CEC9));
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
  }

  /* CTA final */
  .cta-final {
    margin: 64px 0 32px;
    padding: 40px 32px;
    background: linear-gradient(135deg, rgba(108,92,231,0.2) 0%, rgba(0,206,201,0.2) 100%);
    border: 1px solid rgba(108,92,231,0.4);
    border-radius: 20px;
    text-align: center;
  }
  .cta-final h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: #fff;
  }
  .cta-final p {
    color: rgba(255,255,255,0.85);
    margin: 0 0 20px;
    line-height: 1.6;
    font-size: 16px;
  }
  .cta-final-btn {
    display: inline-block;
    background: var(--gradient-primary, linear-gradient(135deg, #6C5CE7, #00CEC9));
    color: #fff;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cta-final-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 12px 32px -8px rgba(108,92,231,0.5);
  }

  /* Tags */
  .article-tags {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border, rgba(255,255,255,0.08));
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .article-tag {
    font-size: 13px;
    color: var(--muted, #94a3b8);
    background: rgba(255,255,255,0.04);
    padding: 4px 12px;
    border-radius: 999px;
  }

  /* Related */
  .related {
    border-top: 1px solid var(--border, rgba(255,255,255,0.08));
    padding: 64px 0 80px;
  }
  .related-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 28px;
    color: #fff;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .related-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s;
  }
  .related-card:hover {
    transform: translateY(-3px);
    border-color: rgba(108,92,231,0.4);
  }
  .related-cover {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.85);
    font-weight: 700;
    padding: 16px;
    text-align: center;
    font-size: 1.1rem;
  }
  .related-info {
    padding: 16px;
  }
  .related-cat {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .related-info h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 8px 0 6px;
    color: #fff;
  }
  .related-info p {
    font-size: 12px;
    color: var(--muted, #94a3b8);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .article-toc {
      position: static;
      max-height: none;
      order: -1;
      padding: 16px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 12px;
    }
  }
</style>

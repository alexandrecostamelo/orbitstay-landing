---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import LegalDocument from '@/components/LegalDocument.astro';
import { TERMS_INTRO, TERMS_SECTIONS, LAST_UPDATED } from '@/data/legal';
---

<Layout
  title="Termos de Uso | ORBITstay"
  description="Termos de Uso da plataforma ORBITstay — licença SaaS, obrigações, pagamento, cancelamento e disposições gerais."
  canonical="https://orbitstay.com.br/termos"
>
  <Navbar />
  <main>
    <LegalDocument
      title="Termos de Uso"
      intro={TERMS_INTRO}
      sections={TERMS_SECTIONS}
      lastUpdated={LAST_UPDATED}
    />
  </main>
  <Footer />
</Layout>
